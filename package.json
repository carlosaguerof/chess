{
  "name": "chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Entrenador personal de aperturas de ajedrez: bots por nivel, base de aperturas y mi repertorio",
  "license": "GPL-3.0-only",
  "scripts": {
    "predev": "node scripts/copiar-motor.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copiar-motor.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "medir": "playwright test --grep @medicion",
    "calibrar": "node scripts/calibrar.ts todo 300 1200",
    "casa": "npm run build && vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "chess.js": "1.4.0",
    "chessground": "9.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
